<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'CrashTests'">
    <DefineConstants>$(DefineConstants);RESEARCHLAB_CRASH_TESTS</DefineConstants>
  </PropertyGroup>
</Project>
